---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Chef OS",
  description = "Danielius's tested recipes, experiments and kitchen knowledge.",
} = Astro.props;
const pageTitle = title === "Chef OS" ? title : `${title} | Chef OS`;
const homeUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171915" />
    <link rel="icon" type="image/svg+xml" href={`${homeUrl}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homeUrl} aria-label="Chef OS home">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>
          <strong>Chef OS</strong>
          <small>Danielius's kitchen</small>
        </span>
      </a>
      <a class="source-link" href="https://github.com/DanieliusIsiunas/cookbook" target="_blank" rel="noreferrer">
        GitHub source
        <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Recipes evolve through cooking, feedback and Git history.</p>
      <a href="https://github.com/DanieliusIsiunas/cookbook" target="_blank" rel="noreferrer">Open the cookbook repository</a>
    </footer>
  </body>
</html>
